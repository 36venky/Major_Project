# ECG Guardian Frontend – Environment variable reference.
# Copy this file to .env and adjust values if needed.

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# For production / ngrok tunnel, change to the public URL:
# VITE_API_URL=https://your-ngrok-id.ngrok.io
# VITE_WS_URL=wss://your-ngrok-id.ngrok.io
