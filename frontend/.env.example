# ECG Guardian Frontend – Environment variable reference.
# Copy this file to .env and fill in your backend URL.
#
# VITE_API_URL is the single source of truth for ALL backend communication:
#   - HTTP REST calls (api.js, apiClient.js, auth.js, and all pages/components)
#   - WebSocket URL  (useWebSocket.js derives wss:// / ws:// automatically)
#
# Only ONE variable needs to change when the backend ngrok tunnel restarts.
# No trailing slash.

# Local development
VITE_API_URL=http://localhost:8000

# ngrok tunnel (update when the tunnel restarts)
# VITE_API_URL=https://YOUR-BACKEND-ID.ngrok-free.app
